# Copy this file to .env before running Docker Compose.
# Never commit the real .env file. Generate unique secrets for production.

# Published host ports
WEB_PORT=80
API_PORT=8080
POSTGRES_PORT=5432

# PostgreSQL (used by Docker Compose)
POSTGRES_USER=restoflow
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=restoflow
COMPOSE_DATABASE_URL=postgres://restoflow:replace_with_a_url_safe_database_password@postgres:5432/restoflow?sslmode=disable

# Backend security (use two different random values, 32+ characters each)
JWT_ACCESS_SECRET=replace_with_a_unique_64_character_random_secret
JWT_REFRESH_SECRET=replace_with_another_unique_64_character_random_secret

# Comma-separated browser origins allowed to call the API directly.
# With the bundled same-origin Nginx setup, set this to your public site URL.
CORS_ORIGINS=https://pos.example.com

DEFAULT_CURRENCY=BDT
DEFAULT_TIMEZONE=Asia/Dhaka
IMAGE_TAG=latest
SEED_DEMO_DATA=false

# Optional frontend build overrides. Leave blank for same-origin /api and /ws.
VITE_API_BASE_URL=
VITE_WS_URL=
